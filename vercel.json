{
  "version": 2,
  "regions": ["bom1"],
  "installCommand": "npm install",
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{node_modules/.prisma/**,node_modules/@prisma/client/**,prisma/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
