# Paste your Postgres connection string here (or copy this file to .env).
# If the password contains @ # : / ? etc, URL-encode it (e.g. @ → %40).
# Example: postgresql://user:Huddledb%401234@HOST:5433/huddle?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/huddle?schema=public"

# JWT secrets — change for production (set these in Vercel → Settings → Environment Variables)
JWT_ACCESS_SECRET="change-me-access-secret-huddle"
JWT_REFRESH_SECRET="change-me-refresh-secret-huddle"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# API
PORT=3000
CORS_ORIGIN="*"

# Vercel Cron protection (required in production). Vercel sends Bearer <CRON_SECRET>.
CRON_SECRET="change-me-cron-secret"

# Firebase Admin (FCM) — never commit real keys. Set these in Vercel env.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Private key: paste the full PEM and keep \n escapes as a single-line string in Vercel
FIREBASE_PRIVATE_KEY=""
# Local only (optional):
# FIREBASE_SERVICE_ACCOUNT_PATH="D:/secrets/hudle-firebase-adminsdk.json"

# Minutes before meeting start to send FCM (default 30).
# REMINDER_MEETING_LEAD_MINUTES=30

# Set automatically by Vercel — do not set locally unless testing serverless paths.
# VERCEL=1

# Receipt OCR: skipped automatically on Vercel (Tesseract is too slow/unreliable there).
# On Railway/VM, OCR runs by default. Override with:
# SKIP_RECEIPT_OCR=true
# ENABLE_RECEIPT_OCR=true   # force OCR on Vercel (not recommended)
