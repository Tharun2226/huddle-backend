generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REIMBURSED
  REJECTED
}

enum ExpenseCategory {
  MEALS
  TRAVEL
  ACCOMMODATION
  SUPPLIES
  SOFTWARE
  CLIENT
  OTHER
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_MOVED
  TASK_COMMENTED
  EXPENSE_SUBMITTED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_REIMBURSED
  MEETING_SCHEDULED
}

enum AuditAction {
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  EXPENSE_REIMBURSED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  tasks           Task[]
  meetings        Meeting[]
  expenses        Expense[]
  activityEvents  ActivityEvent[]
  auditLogs       AuditLog[]
  roles           Role[]
  taskStatuses    OrgTaskStatus[]
  taskPriorities  OrgTaskPriority[]
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isDefault      Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String @default("")

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model OrgTaskStatus {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  color          String   @default("#6B7280")
  sortOrder      Int      @default(0)
  isDefault      Boolean  @default(false)
  isDone         Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OrgTaskPriority {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  color          String   @default("#6B7280")
  sortOrder      Int      @default(0)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  managerId      String?
  email          String
  name           String
  title          String   @default("")
  passwordHash   String
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      User?        @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]       @relation("ManagerReports")

  roles            UserRole[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  taskAssignments  TaskAssignee[]
  taskComments     TaskComment[]
  meetingAttendees MeetingAttendee[]
  expenses         Expense[]        @relation("ExpenseSubmitter")
  decidedExpenses  Expense[]        @relation("ExpenseDecider")
  activityEvents   ActivityEvent[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([managerId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String   @default("")
  statusId       String
  priorityId     String
  dueDate        DateTime?
  assigneeId     String
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status       OrgTaskStatus       @relation(fields: [statusId], references: [id])
  priority     OrgTaskPriority     @relation(fields: [priorityId], references: [id])
  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  meetings     Meeting[]
  assignees    TaskAssignee[]

  @@index([organizationId])
  @@index([assigneeId])
  @@index([statusId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  label  String
  done   Boolean @default(false)
  sortOrder Int  @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model Meeting {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  start          DateTime
  end            DateTime
  location       String   @default("")
  notes          String   @default("")
  /// Join / redirect URL (Meet, Zoom, etc.)
  link           String   @default("")
  /// none | daily | weekly
  recurrence     String   @default("none")
  /// Dart weekday numbers: 1=Mon ... 7=Sun (used when recurrence=weekly)
  weekdays       Int[]    @default([])
  taskId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  attendees    MeetingAttendee[]

  @@index([organizationId])
  @@index([start])
  @@index([taskId])
}

model MeetingAttendee {
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  amount         Decimal         @db.Decimal(12, 2)
  category       ExpenseCategory
  date           DateTime
  merchant       String
  notes          String          @default("")
  status         ExpenseStatus   @default(DRAFT)
  submitterId    String
  receiptUrl     String?
  decidedAt      DateTime?
  decidedById    String?
  decisionNote   String          @default("")
  reimbursedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submitter    User         @relation("ExpenseSubmitter", fields: [submitterId], references: [id])
  decidedBy    User?        @relation("ExpenseDecider", fields: [decidedById], references: [id])

  @@index([organizationId])
  @@index([submitterId])
  @@index([status])
}

model ActivityEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  type           ActivityType
  subject        String
  amount         Decimal?     @db.Decimal(12, 2)
  targetId       String?
  at             DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, at])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String
  action         AuditAction
  targetType     String
  targetId       String
  note           String      @default("")
  metadata       Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
}
